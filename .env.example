# Server port (Hostinger injects PORT automatically; defaults to 3000)
PORT=3000

# Runtime environment ("production" on Hostinger, "development" locally)
NODE_ENV=production

# Google Gemini API key (called directly via @google/genai when AI rewrite mode is used)
GEMINI_API_KEY=

# Optional owner login credentials managed via environment variables.
# If OWNER_PASSWORD is left blank, use the first-run setup screen in the app.
OWNER_EMAIL=
OWNER_PASSWORD=

# Secret used to sign login session tokens (set a random 32+ character string in production)
SESSION_SECRET=

# Optional custom directory for persistent JSON data storage (defaults to ./data)
DATA_DIR=
